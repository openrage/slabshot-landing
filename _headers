# Cloudflare Pages headers. Static front door — lock it down; no third-party scripts needed.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'

# Long-cache the immutable assets (fonts/img/css are content-stable).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
